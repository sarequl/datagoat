# Copy to .env for local development. Never commit .env.
# Values here are placeholders, not real secrets.

# Signs the dashboard session cookie. Use a long random string.
SESSION_SECRET=change-me-session-secret

# Per-install key used to derive cookieless visitor ids. Rotating it resets
# all cookieless visitor ids.
COOKIELESS_SALT=change-me-cookieless-salt

# Optional: report cross-currency LTV in USD.
FX_PROVIDER=

# Optional: payment provider webhook secrets.
STRIPE_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
DODO_WEBHOOK_SECRET=
CREEM_WEBHOOK_SECRET=
