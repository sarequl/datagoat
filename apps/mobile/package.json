{
  "name": "datagoat-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DataGoat companion app for iOS and Android (Expo).",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "check": "npm run typecheck && npm run export"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
